# Public app Railway service (separate from Homebase API) — paste into Variables, never commit secrets.

# Tenant Postgres where the admin plugin stores rows (NOT Neon main / Homebase DATABASE_URL)
APP_DB_URL=postgresql://...@....neon.tech/neondb?sslmode=require

APP_ALLOWED_ORIGINS=https://example.se,https://www.example.se
APP_PUBLIC_URL=https://www.example.se
APP_CACHE_TTL=60

# Homebase Node API (org name + logo from Account Profile / tenants.organization)
APP_HOMEBASE_API_URL=https://homebase.example.se
# Optional: read Account Profile directly from main DB (local / special setups)
# APP_MAIN_DATABASE_URL=postgresql://...
# PUBLIC_CLUBDESK_USER_ID=1
# Optional fallbacks when Homebase API / main DB are unavailable:
# APP_ORG_NAME=Min förening
# APP_ORG_LOGO_URL=https://...

# APP_DEBUG_ERRORS=1
