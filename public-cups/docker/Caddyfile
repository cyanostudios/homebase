:{$PORT:8080} {
	root * /app
	# Prefer zstd, then gzip (Sitegrade L6). Cloudflare may also negotiate brotli at the edge.
	encode zstd gzip

	@cupApi path /api/*
	handle @cupApi {
		php_fastcgi 127.0.0.1:9000
	}

	@sitemap path /sitemap.xml
	handle @sitemap {
		rewrite * /api/sitemap.php
		php_fastcgi 127.0.0.1:9000
	}

	# Browsers request /favicon.ico; keep SPA fallback from serving index.html as the icon.
	handle /favicon.ico {
		redir /favicon.svg permanent
	}

	# Legacy /cup/... and new /{district}/{cup-slug}
	# API is handled above so /api/* never hits this regexp.
	@legacyCup path /cup /cup/*
	handle @legacyCup {
		rewrite * /cup.php
		php_fastcgi 127.0.0.1:9000
	}

	@districtCup path_regexp district_cup ^/[a-z0-9-]+/[a-z0-9-]+/?$
	handle @districtCup {
		rewrite * /cup.php
		php_fastcgi 127.0.0.1:9000
	}

	# Execute via FPM — without this, try_files/file_server could expose *.php raw.
	handle /cup.php {
		php_fastcgi 127.0.0.1:9000
	}

	handle /router.php {
		respond "Not Found" 404
	}

	# Long-lived cache for versioned-ish static assets (Sitegrade L8).
	@staticAssets path *.css *.js *.svg *.png *.webp *.jpg *.jpeg *.woff2 *.ico *.txt
	handle @staticAssets {
		header {
			-X-Powered-By
			X-Content-Type-Options "nosniff"
			Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
		}
		file_server
	}

	handle {
		header {
			-X-Powered-By
			X-Content-Type-Options "nosniff"
			Referrer-Policy "strict-origin-when-cross-origin"
			Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
			X-Frame-Options "SAMEORIGIN"
			Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self' https://www.googletagmanager.com https://www.google-analytics.com https://tagmanager.google.com; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https:; frame-src https://www.googletagmanager.com; form-action 'self'; upgrade-insecure-requests"
			# HTML shell / SPA routes — revalidate promptly
			Cache-Control "no-cache"
		}
		try_files {path} /index.html
		file_server
	}
}
